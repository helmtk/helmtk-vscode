{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Helmtk",
  "scopeName": "source.helmtk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#function-calls" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.helmtk",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.helmtk",
          "match": "\\b(if|else|end|for|in|do|break|continue)\\b"
        },
        {
          "name": "keyword.other.helmtk",
          "match": "\\b(let|define|include|spread)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.helmtk",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.helmtk",
          "match": "\\bnull\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.helmtk",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#string-interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.helmtk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.helmtk",
              "match": "\\\\."
            },
            {
              "include": "#string-interpolation"
            }
          ]
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.expression.helmtk",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.helmtk" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.helmtk" }
          },
          "patterns": [
            { "include": "#keywords" },
            { "include": "#operators" },
            { "include": "#identifiers" },
            { "include": "#numbers" },
            { "include": "#function-calls" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.helmtk",
          "match": "\\b-?\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.helmtk",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.helmtk",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.comparison.helmtk",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.helmtk",
          "match": "(\\+|-|\\*|/)"
        },
        {
          "name": "keyword.operator.pipe.helmtk",
          "match": "\\|(?!\\|)"
        },
        {
          "name": "keyword.operator.assignment.helmtk",
          "match": "="
        },
        {
          "name": "punctuation.accessor.helmtk",
          "match": "\\."
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.helmtk",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.helmtk" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.constant.helmtk",
          "match": "\\b(Values|Release|Chart|Capabilities|Template|Files)\\b"
        },
        {
          "name": "variable.other.helmtk",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
